# Database
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://fincherry:change-me-strong-password@localhost:5432/fincherry

# Auth — store as bcrypt hash of your chosen passphrase
# Generate with:
#   pnpm --filter @fincherry/api exec node -e "const b=require('bcryptjs');console.log(b.hashSync('your-passphrase',12))"
# Wrap in single quotes to avoid Docker Compose `$` interpolation warnings.
# Login uses your plain passphrase, not this hash value.
AUTH_PASSPHRASE_HASH=''
# Optional: partner passphrase hash for read-only access
# Generate with: node -e "require('bcryptjs').hash('partner-passphrase', 10).then(console.log)"
PARTNER_PASSPHRASE_HASH=''

# JWT — random secret, min 32 chars
JWT_SECRET=change-me-random-32-char-secret

# AI (optional)
GEMINI_API_KEY=
GEMINI_INSIGHTS_MODEL=gemini-2.5-flash
GEMINI_CATEGORIZATION_MODEL=gemini-2.5-flash

# App
NODE_ENV=development
PORT=3000
