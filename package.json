{
  "name": "fincherry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "build:api": "pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "web:bundle:check": "node ./scripts/check-web-bundle-size.mjs",
    "web:bundle:report": "node ./scripts/check-web-bundle-size.mjs --report-only",
    "db:up": "docker compose up -d db --force-recreate",
    "db:backup": "bash ./scripts/db-backup.sh",
    "db:backup:cron": "bash ./scripts/install-backup-cron.sh",
    "db:restore": "bash ./scripts/db-restore.sh",
    "db:restore:verify": "bash ./scripts/db-restore-verify.sh",
    "db:push": "pnpm --filter @fincherry/api db:push",
    "db:setup": "pnpm db:up && pnpm db:push && pnpm db:seed",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:backfill-categories": "pnpm --filter @fincherry/api db:backfill-categories",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
