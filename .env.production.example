# Database — must match the password set in infra/.env for the fincherry user
DB_PASSWORD=change-me-strong-password

# Auth — bcrypt hash of your chosen passphrase
# Generate with:
#   docker run --rm node:20-alpine node -e "const b=require('bcryptjs');console.log(b.hashSync('your-passphrase',12))"
# Wrap in single quotes to avoid Docker Compose `$` interpolation warnings.
AUTH_PASSPHRASE_HASH=''

# JWT — random secret, min 32 chars
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-random-32-char-secret

# AI (optional — leave empty to disable AI features)
GEMINI_API_KEY=
GEMINI_INSIGHTS_MODEL=gemini-2.5-flash
GEMINI_CATEGORIZATION_MODEL=gemini-2.5-flash
